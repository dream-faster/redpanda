# Seastar's HTTP parsers, generated from its src/http/*.rl by ragel 6
# (`ragel -G2 -L`) at the Seastar revision pinned in bazel/repositories.bzl.
# Checked in so a cold build does not compile ragel and its colm/libfsm
# toolchain first. Regenerate them whenever those .rl files change.
exports_files(
    [
        "chunk_parsers.hh",
        "request_parser.hh",
        "response_parser.hh",
    ],
    visibility = ["//visibility:public"],
)
