diff --git a/include/seastar/util/parent_from_member.hh b/include/seastar/util/parent_from_member.hh
new file mode 100644
index 0000000..8fb3113
--- /dev/null
+++ b/include/seastar/util/parent_from_member.hh
@@ -0,0 +1,16 @@
+#pragma once
+// Replacement for boost::intrusive::get_parent_from_member that avoids pulling
+// ~35 Boost headers into every translation unit through shared_ptr.hh.
+#include <cstddef>
+
+namespace seastar::internal {
+
+template <class Parent, class Member>
+inline Parent* parent_from_member(Member* member, const Member Parent::*ptr_to_member) noexcept {
+    // Same offset trick Boost uses, without its configuration headers.
+    const Parent* const p = nullptr;
+    const auto offset = reinterpret_cast<const char*>(&(p->*ptr_to_member)) - reinterpret_cast<const char*>(p);
+    return reinterpret_cast<Parent*>(reinterpret_cast<char*>(member) - offset);
+}
+
+} // namespace seastar::internal
diff --git a/include/seastar/util/spsc_queue.hh b/include/seastar/util/spsc_queue.hh
new file mode 100644
index 0000000..8d5cf14
--- /dev/null
+++ b/include/seastar/util/spsc_queue.hh
@@ -0,0 +1,63 @@
+#pragma once
+// Minimal bounded single-producer/single-consumer ring replacing
+// boost::lockfree::spsc_queue<T, boost::lockfree::capacity<N>> in smp.hh.
+#include <atomic>
+#include <cstddef>
+#include <array>
+
+namespace seastar::internal {
+
+template <typename T, std::size_t Capacity>
+class spsc_queue {
+    // one slot is kept free to distinguish full from empty, like boost does
+    static constexpr std::size_t slots = Capacity + 1;
+    alignas(64) std::atomic<std::size_t> _write{0};
+    alignas(64) std::atomic<std::size_t> _read{0};
+    alignas(64) std::array<T, slots> _ring;
+    static std::size_t next(std::size_t i) noexcept { return i + 1 == slots ? 0 : i + 1; }
+public:
+    bool push(const T& v) noexcept {
+        auto w = _write.load(std::memory_order_relaxed);
+        auto n = next(w);
+        if (n == _read.load(std::memory_order_acquire)) {
+            return false;
+        }
+        _ring[w] = v;
+        _write.store(n, std::memory_order_release);
+        return true;
+    }
+    template <typename It>
+    It push(It begin, It end) noexcept {
+        while (begin != end && push(*begin)) {
+            ++begin;
+        }
+        return begin;
+    }
+    bool pop(T& out) noexcept {
+        auto r = _read.load(std::memory_order_relaxed);
+        if (r == _write.load(std::memory_order_acquire)) {
+            return false;
+        }
+        out = _ring[r];
+        _read.store(next(r), std::memory_order_release);
+        return true;
+    }
+    template <typename F>
+    std::size_t consume_all(F&& f) {
+        std::size_t n = 0;
+        T v;
+        while (pop(v)) {
+            f(v);
+            ++n;
+        }
+        return n;
+    }
+    bool empty() const noexcept { return _read.load(std::memory_order_acquire) == _write.load(std::memory_order_acquire); }
+    std::size_t read_available() const noexcept {
+        auto w = _write.load(std::memory_order_acquire);
+        auto r = _read.load(std::memory_order_acquire);
+        return w >= r ? w - r : slots - r + w;
+    }
+};
+
+} // namespace seastar::internal
diff --git a/include/seastar/util/static_vector.hh b/include/seastar/util/static_vector.hh
new file mode 100644
index 0000000..55dcd2c
--- /dev/null
+++ b/include/seastar/util/static_vector.hh
@@ -0,0 +1,54 @@
+#pragma once
+// Minimal fixed-capacity vector, a stand-in for boost::container::static_vector
+// on the headers that are included by almost every translation unit.
+#include <cstddef>
+#include <new>
+#include <algorithm>
+#include <utility>
+#include <initializer_list>
+
+namespace seastar::internal {
+
+template <typename T, std::size_t N>
+class static_vector {
+    alignas(T) unsigned char _buf[sizeof(T) * N];
+    std::size_t _size = 0;
+    T* ptr() noexcept { return std::launder(reinterpret_cast<T*>(_buf)); }
+    const T* ptr() const noexcept { return std::launder(reinterpret_cast<const T*>(_buf)); }
+public:
+    using value_type = T;
+    using size_type = std::size_t;
+    using iterator = T*;
+    using const_iterator = const T*;
+    static_vector() noexcept = default;
+    static_vector(const static_vector& o) { for (auto& e : o) emplace_back(e); }
+    static_vector(static_vector&& o) noexcept(std::is_nothrow_move_constructible_v<T>) { for (auto& e : o) emplace_back(std::move(e)); }
+    static_vector& operator=(const static_vector& o) { if (this != &o) { clear(); for (auto& e : o) emplace_back(e); } return *this; }
+    static_vector& operator=(static_vector&& o) noexcept(std::is_nothrow_move_constructible_v<T>) { if (this != &o) { clear(); for (auto& e : o) emplace_back(std::move(e)); } return *this; }
+    ~static_vector() { clear(); }
+    template <typename... A> T& emplace_back(A&&... a) { auto* p = new (ptr() + _size) T(std::forward<A>(a)...); ++_size; return *p; }
+    void push_back(const T& v) { emplace_back(v); }
+    void push_back(T&& v) { emplace_back(std::move(v)); }
+    void pop_back() { ptr()[--_size].~T(); }
+    void clear() noexcept { while (_size) pop_back(); }
+    bool empty() const noexcept { return _size == 0; }
+    std::size_t size() const noexcept { return _size; }
+    static constexpr std::size_t capacity() noexcept { return N; }
+    static constexpr std::size_t max_size() noexcept { return N; }
+    T* data() noexcept { return ptr(); }
+    const T* data() const noexcept { return ptr(); }
+    iterator begin() noexcept { return ptr(); }
+    iterator end() noexcept { return ptr() + _size; }
+    const_iterator begin() const noexcept { return ptr(); }
+    const_iterator end() const noexcept { return ptr() + _size; }
+    T& operator[](std::size_t i) noexcept { return ptr()[i]; }
+    const T& operator[](std::size_t i) const noexcept { return ptr()[i]; }
+    T& back() noexcept { return ptr()[_size - 1]; }
+    const T& back() const noexcept { return ptr()[_size - 1]; }
+    T& front() noexcept { return ptr()[0]; }
+    friend bool operator==(const static_vector& a, const static_vector& b) {
+        return a._size == b._size && std::equal(a.begin(), a.end(), b.begin());
+    }
+};
+
+} // namespace seastar::internal
